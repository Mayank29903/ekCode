# Copy to .env and edit. Never commit .env.
# Comments sit on their own lines: some .env parsers keep an inline "# ..." as part of the value.

# --- core (required) ---
DATABASE_URL=postgresql+psycopg://ekcode:ekcode@db:5432/ekcode
REDIS_URL=redis://redis:6379/0
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-random-chars
ADMIN_EMAIL=admin@ekcode.local
ADMIN_PASSWORD=ChangeMe@2026
DATA_DIR=/data
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Set to true behind HTTPS
COOKIE_SECURE=false

# --- ML ---
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- LLM (optional): noop | ollama | gemini | groq ---
LLM_PROVIDER=noop
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
GEMINI_API_KEY=
# Use the current free Flash model name shown in Google AI Studio
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# Check console.groq.com for current models
GROQ_MODEL=llama-3.3-70b-versatile

# --- SAP sandbox (optional) ---
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_PRODUCT_SRV
SAP_API_KEY=

# --- data.gov.in (optional) ---
DATAGOVINDIA_API_KEY=

# --- operations (optional; these are the defaults) ---
# Set to false in production to hide the interactive API docs at /api/docs
DOCS_ENABLED=true
LOG_LEVEL=INFO
# Largest accepted upload, in MB (also raise client_max_body_size in frontend/nginx.conf)
MAX_UPLOAD_MB=100
# A queued or running upload with no progress for this many minutes can be restarted from the Upload page
STALE_JOB_MINUTES=30
